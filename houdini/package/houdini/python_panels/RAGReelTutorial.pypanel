<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <interface name="RAGReelTutorial" label="RAGReel Tutorial" icon="MISC_python" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[
# A thin loader: the real panel lives in rag_chatbot.py, which the package puts on PYTHONPATH
# (houdini/package/install.ps1). Updating the panel never needs this file to be edited again.
# If the panel cannot start, show the reason (and where Python looked) instead of a bare traceback.
# Keep this script ASCII only (Houdini 22 reads it as Latin-1): Japanese text is written as unicode escapes.
def onCreateInterface():
    try:
        import rag_chatbot
        return rag_chatbot.onCreateInterface()
    except Exception:
        import os
        import sys
        import traceback
        from PySide6 import QtWidgets
        home = os.environ.get("RAGREEL_TUTORIAL_HOME", "(not set)")
        found = [p for p in sys.path if "RAGReelTutorial" in p]
        lines = [
            "RAGReel Tutorial \u3092\u958b\u3051\u307e\u305b\u3093\u3067\u3057\u305f\u3002",
            "RAGReel Tutorial could not start.",
            "",
            "\u6b21\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\uff08\u5c0e\u5165\u624b\u9806\u306e\u300c\u56f0\u3063\u305f\u3068\u304d\u300d\u3092\u53c2\u7167\uff09:",
            "1. install.cmd \u3092\u3082\u3046\u4e00\u5ea6\u5b9f\u884c\u3057\u3001Houdini \u3092\u518d\u8d77\u52d5\u3059\u308b",
            "2. Houdini \u306e Python Shell \u3067  import rag_chatbot  \u3092\u5b9f\u884c\u3057\u3001\u51fa\u305f\u30a8\u30e9\u30fc\u3092\u78ba\u8a8d\u3059\u308b",
            "",
            "RAGREEL_TUTORIAL_HOME = " + home,
            "rag_chatbot.py exists = " + str(os.path.exists(os.path.join(home, "python", "rag_chatbot.py"))),
            "on sys.path = " + (", ".join(found) if found else "(not found)"),
            "",
            traceback.format_exc(),
        ]
        view = QtWidgets.QPlainTextEdit("\n".join(lines))
        view.setReadOnly(True)
        return view
]]></script>
    <includeInPaneTabMenu menu_position="210" create_separator="false"/>
    <includeInToolbarMenu menu_position="210" create_separator="false"/>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
