{
  "name": "cloudflare-rag-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud RAG（Cloudflare Worker）の現行実装。旧GAS版（gas_cloud_rag.js）は2026-10-22に廃止",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rag-poc-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rag-poc-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  }
}
